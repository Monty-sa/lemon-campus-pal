# LEMON environment template. Copy to .env.local and fill in only if you are
# enabling optional accounts and private cloud schedules. Guest mode needs no
# environment variables.

# Public browser configuration. URL and either ANON_KEY or PUBLISHABLE_KEY are required together, or neither.
# Keep true for the public guest-only release until migration 0006 and two-user
# staging RLS/OAuth verification have passed.
NEXT_PUBLIC_GUEST_ONLY_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by privileged admin metrics and account deletion. Never prefix this
# with NEXT_PUBLIC_ and never import it into client components.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only KFU monitor controls. Keep polling disabled until source access
# and an approved refresh process are documented. CRON_SECRET must be set before
# the HTTP refresh route can accept a request.
# CRON_SECRET=
# KFU_MONITOR_CRON_ENABLED=false
# KFU_BLOBS_STORE_NAME=

# Server-only HMAC secret used by the Windows worker and ingestion endpoint.
# Store the real worker value outside the repository.
# KFU_INGESTION_SECRET=
# KFU_INGESTION_ENDPOINT=https://your-site.example/api/kfu/ingest
